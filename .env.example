# dfirbench configuration (guide Appendix C). Copy to `.env` at the repo root and edit.
# The backend reads ./.env or ../.env (so it works from backend/); docker compose reads it when
# run with `--env-file .env`. Values below are DEV placeholders: APP_ENV=prod refuses them.
# Never commit a real .env.

# --- Core -----------------------------------------------------------------------------------
# dev | test | prod
APP_ENV=dev
LOG_LEVEL=INFO
LOG_JSON=true
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Stores (host-side URLs; compose overrides these with service hostnames) ------------------
# Use 127.0.0.1 rather than localhost on Windows (localhost tries IPv6 first and stalls).
POSTGRES_PASSWORD=dfir_dev_password
DATABASE_URL=postgresql+psycopg://dfir:dfir_dev_password@127.0.0.1:5432/dfirbench
# Least-privilege role (migration 0002) every app session runs as; empty = the login role.
DATABASE_APP_ROLE=dfirbench_app
REDIS_URL=redis://127.0.0.1:6379/0
# Full profile only
ENABLE_OPENSEARCH=false
# OPENSEARCH_URL=http://opensearch:9200

# --- Evidence vault (MinIO / S3) ---------------------------------------------------------------
MINIO_ROOT_USER=dfir
MINIO_ROOT_PASSWORD=minio_dev_password
S3_ENDPOINT=127.0.0.1:9000
S3_ACCESS_KEY=dfir
S3_SECRET_KEY=minio_dev_password
S3_SECURE=false
VAULT_BUCKET=evidence
ARTIFACTS_BUCKET=artifacts
VAULT_RETENTION_DAYS=3650

# --- Auth (Phase 1) --------------------------------------------------------------------------
# prod: >= 32 random characters each (e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`)
JWT_SECRET=dev-only-jwt-secret-change-me
# Ed25519 PEM -> EdDSA access tokens instead of HS256
# JWT_PRIVATE_KEY_PATH=
# JWT_KEY_ID=jwt-1
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
SESSION_ABSOLUTE_DAYS=30
TOTP_ENC_KEY=dev-only-totp-key-change-me
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_BASE_S=60
LOGIN_LOCKOUT_MAX_S=3600
AUDITOR_ALL_CASES=true

# --- Custody signing (Ed25519) -----------------------------------------------------------------
# Host-side dev key (git-ignored var/): bash scripts/dev-keygen.sh
# Compose generates its own key in the `custodykeys` volume (keygen job).
# CUSTODY_SIGNING_KEY_PATH=../var/keys/custody-dev.pem
# CUSTODY_SIGNING_KEY_PASSPHRASE=
# Default key id: ed25519-<fingerprint>
# CUSTODY_KEY_ID=
# Verification trusts ONLY the running signer plus the keys in this JSON file ({key_id: public PEM}),
# never rows in the signing_keys table. Before rotating, add the old key:
#   python -m app.core.signing trust <old.pem> --file ../var/keys/trusted.json
# The file is a trust anchor: keep it on a read-only mount the API/worker user cannot write.
# CUSTODY_TRUSTED_KEYS_PATH=../var/keys/trusted.json

# --- Limits / sandbox ------------------------------------------------------------------------
MAX_UPLOAD_GB=20
# S3 multipart part size = the per-upload memory bound
UPLOAD_PART_SIZE_MB=8
PARSER_TIMEOUT_S=3600
PARSER_MAX_OUTPUT_MB=2048
# docker | k8s | none
SANDBOX_MODE=none

# --- Processing pipeline (Phase 2) -----------------------------------------------------------
# Per-job scratch dir root (empty = <system temp>/dfirbench-scratch; compose mounts a volume)
# SCRATCH_DIR=
INGEST_BATCH_SIZE=1000
INGEST_FLUSH_INTERVAL_S=5
# A running job without a heartbeat for this long is reclaimed by the next delivery
JOB_LEASE_S=900
# Automatic retries for transient errors (I/O, database), exponential backoff
JOB_MAX_AUTO_RETRIES=3
PARSER_MAX_LINE_KB=64
PARSER_MAX_DECOMPRESSED_MB=4096
PARSER_MAX_DECOMPRESSION_RATIO=200
MAX_NEW_PARTITIONS_PER_JOB=48

# --- Analysis (Phase 4) ---------------------------------------------------------------------
SEARCH_TIMEOUT_MS=15000
EXPORT_MAX_ROWS=10000
ENTITY_RESOLUTION=true
# Refresh-token cookie for the web UI (HttpOnly, SameSite=Strict). Keep Secure on; browsers accept
# Secure cookies from http://localhost. Set false only for plain-HTTP dev hosts other than localhost.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_NAME=dfir_refresh

# --- Collection (Phase 5) -------------------------------------------------------------------
# Triage bundle ingest limits (bundles are hostile input: zip bombs, traversal, symlinks)
BUNDLE_MAX_MEMBERS=10000
BUNDLE_MAX_TOTAL_MB=4096
BUNDLE_MAX_MEMBER_MB=2048
BUNDLE_MAX_RATIO=200
BUNDLE_MAX_DERIVED=500
# Extra trusted collector SHA-256 list (trust anchor; read-only mount), same format as
# backend/app/collection/trusted_collectors.json
# COLLECTOR_TRUSTED_HASHES_PATH=

# --- AI (Phase 7, docs/ai.md) ------------------------------------------------------------------
# AI is off unless ENABLE_AI=true. Only backend/app/ai/gateway.py sends data to a model.
ENABLE_AI=false
# true = refuse hosted providers (anthropic; openai_compat unless its URL is loopback/a compose name)
AI_LOCAL_ONLY=false
# anthropic | ollama | openai_compat | fake (fake = offline demo/test provider; refused in prod)
LLM_PROVIDER=anthropic
# Secret: set it in your real .env only. Never commit a key.
LLM_API_KEY=
# anthropic: empty = https://api.anthropic.com ; ollama: http://ollama:11434 ; openai_compat: .../v1
# LLM_BASE_URL=
# Model ids are configuration (fast: NL search; strong: explanations, narrative, chat, scripts)
LLM_MODEL_FAST=claude-haiku-4-5-20251001
LLM_MODEL_STRONG=claude-sonnet-5-5
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=1
# Anthropic only: low | medium | high | xhigh | max (unset = model default; not sent to Haiku)
# LLM_EFFORT=
# Anthropic server-side refusal fallback on models that support it
LLM_ANTHROPIC_FALLBACKS=true
# USD per million tokens, for cost_usd and AI_DAILY_BUDGET_USD (unset = cost not tracked)
# LLM_PRICE_INPUT_PER_MTOK=
# LLM_PRICE_OUTPUT_PER_MTOK=
# none | standard (e-mails, secrets) | strict (+ IPs, user and host names); hosted providers only
AI_REDACTION_POLICY=standard
AI_REDACT_LOCAL=false
AI_MAX_TOKENS=8000
AI_MAX_INPUT_CHARS=120000
AI_MAX_FIELD_CHARS=512
AI_MAX_PACK_RECORDS=150
AI_RATE_LIMIT_PER_MINUTE=10
AI_CASE_RATE_LIMIT_PER_HOUR=200
AI_DAILY_TOKEN_BUDGET=2000000
AI_DAILY_BUDGET_USD=10
# RAG index: hashing (local, deterministic, 384-d) | ollama | openai_compat (must return 384-d)
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=hashing-v1
# event_chunks.embedding is vector(384); another dimension needs a migration
EMBEDDING_DIM=384
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
AI_INDEX_MAX_EVENTS=200000
AI_CHAT_TOP_K=8
AI_CHAT_MAX_EVENTS=120

# --- Reporting (Phase 8, docs/reports.md) ----------------------------------------------------
# Snapshot caps per report (truncation is recorded in the report) and the organisation shown on
# the cover and as the STIX identity. Signed artifacts go to ARTIFACTS_BUCKET.
REPORT_MAX_KEY_EVENTS=500
REPORT_MAX_ALERTS=500
REPORT_MAX_IOCS=1000
REPORT_MAX_CONTEXT_MB=8
REPORT_ORG_NAME=dfirbench

# --- Integrations (Phase 9) ------------------------------------------------------------------
# VT_API_KEY=
# MISP_URL=
# MISP_KEY=
# SLACK_WEBHOOK_URL=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# --- Host port overrides for infra/compose.yaml ----------------------------------------------
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# API_PORT=8000
# WEB_PORT=8080
# Fixed compose subnet + web (nginx) address trusted for X-Forwarded-For; change if it collides.
# WEB_SUBNET=172.30.240.0/24
# WEB_IP=172.30.240.10

# --- Deep parsers (Phase 6) -----------------------------------------------------------------
# External engines (Sleuth Kit fls/mmls, Volatility 3 vol, optional zeek) are looked up here
# (os.pathsep-separated); empty = PATH. They run with a clean environment in the job scratch dir.
# TOOL_SEARCH_PATH=
TOOL_TIMEOUT_S=3600
TOOL_MAX_OUTPUT_MB=1024
# Registry hives, SQLite browser DBs and PE files larger than this are refused
PARSER_MAX_STRUCTURED_MB=1024
PARSER_MAX_RECORDS=5000000
PARSER_SQLITE_TIMEOUT_S=600
# Extra trusted YARA rules (*.yar/*.yara, read-only mount); the packaged pack is always used
# YARA_RULES_DIR=
YARA_TIMEOUT_S=600
YARA_MAX_FILE_MB=2048
# Volatility 3 symbol packs (ISF); unset = none, Volatility always runs --offline
# VOLATILITY_SYMBOLS_DIR=
